rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Avatars
    match /avatars/{userId}/{fileName} {
      allow read: if true; // Public read
      allow write: if request.auth != null && 
                      request.auth.uid == userId &&
                      request.resource.size < 5 * 1024 * 1024 && // 5MB max
                      request.resource.contentType.matches('image/.*');
    }
    
    // Task images
    match /tasks/{taskId}/{fileName} {
      allow read: if true; // Public read
      allow write: if request.auth != null &&
                      request.resource.size < 10 * 1024 * 1024 && // 10MB max
                      request.resource.contentType.matches('image/.*');
    }
    
    // Chat files
    match /chat/{conversationId}/{messageId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.resource.size < 20 * 1024 * 1024; // 20MB max
    }
    
    // Message images
    match /messages/{conversationId}/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 5 * 1024 * 1024 && // 5MB max
                      request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && 
                       request.auth.uid == userId;
    }
    
    // KYC Documents
    match /kyc/{userId}/{fileName} {
      // Users can read their own documents, admins can read all
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin'])
      );
      
      // Users can upload their own KYC documents
      allow write: if request.auth != null &&
                      request.auth.uid == userId &&
                      request.resource.size < 10 * 1024 * 1024 && // 10MB max
                      (request.resource.contentType.matches('image/.*') ||
                       request.resource.contentType.matches('application/pdf'));
      
      // Users can delete their own documents (before submission or after rejection)
      allow delete: if request.auth != null && 
                       request.auth.uid == userId;
    }
    
    // Review Photos
    match /reviews/{reviewId}/{fileName} {
      // Public read for all review photos
      allow read: if true;
      
      // Write: Only review owner, max 5 photos per review, 5MB each, images only
      allow write: if request.auth != null &&
                      // Check review exists and user is the reviewer
                      firestore.get(/databases/(default)/documents/reviews/$(reviewId)).data.reviewerId == request.auth.uid &&
                      // Max 5MB per photo
                      request.resource.size < 5 * 1024 * 1024 &&
                      // Only image formats: jpg, jpeg, png, webp
                      request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      
      // Delete: Only review owner or admin
      allow delete: if request.auth != null && (
        firestore.get(/databases/(default)/documents/reviews/$(reviewId)).data.reviewerId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin'])
      );
    }
  }
}
