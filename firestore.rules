rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // Soft delete only
      
      // Users can update their own data except roles (admin only)
      allow update: if isAuthenticated() && isOwner(userId) && 
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles']));
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       request.resource.data.clientId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow delete: if isAuthenticated() && 
                       resource.data.clientId == request.auth.uid;
    }
    
    // Proposals collection
    match /proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       request.resource.data.providerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.providerId == request.auth.uid ||
        get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.clientId == request.auth.uid
      );
      allow delete: if isAuthenticated() && 
                       resource.data.providerId == request.auth.uid;
    }
    
    // Offers collection
    match /offers/{offerId} {
      // Lecture: provider, client ou admin
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.providerId ||
        request.auth.uid == resource.data.clientId
      );
      
      // Création: provider uniquement, pour tasks ouvertes
      allow create: if isAuthenticated() &&
        request.auth.uid == request.resource.data.providerId &&
        exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)) &&
        get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.status == 'open';
      
      // Modification: provider (withdraw) ou client (accept/reject)
      allow update: if isAuthenticated() && (
        (request.auth.uid == resource.data.providerId && request.resource.data.status == 'withdrawn') ||
        (request.auth.uid == resource.data.clientId && request.resource.data.status in ['accepted', 'rejected'])
      );
      
      // Suppression: interdite
      allow delete: if false;
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid
      );
      allow delete: if false;
    }
    
    // Conversations collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && 
        request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && 
        request.auth.uid in resource.data.participants;
      allow delete: if false; // Admin only
    }
    
    // Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants;
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.senderId &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants &&
        (request.resource.data.type == 'text' || 
         (request.resource.data.type == 'image' && request.resource.data.keys().hasAll(['fileUrl'])));
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && 
        request.auth.uid == resource.data.senderId;
    }
    
    // Reviews
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       request.resource.data.reviewerId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // TEMPORARY: Allow full read/list access for debugging
      // TODO: Restore security after fixing the issue
      allow read, list: if isAuthenticated();
      
      // Only Cloud Functions can create notifications
      allow create: if false;
      
      // Users can update only 'read', 'dismissed', 'shown' fields
      allow update: if isAuthenticated() && 
        isOwner(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'dismissed', 'shown', 'updatedAt']) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.category == resource.data.category;
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // KYC Submissions collection
    match /kyc_submissions/{submissionId} {
      // Function to check if user is admin
      function isAdmin() {
        return isAuthenticated() && 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
      }
      
      // Users can read their own submissions, admins can read all
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || 
        isAdmin()
      );
      
      // Users can create their own submissions
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.documents.size() >= 1 &&
                       request.resource.data.documents.size() <= 10;
      
      // Only admins can update submissions (approval/rejection)
      allow update: if isAdmin() &&
                       resource.data.userId == request.resource.data.userId &&
                       request.resource.data.status in ['approved', 'rejected'];
      
      // Users cannot delete submissions
      allow delete: if false;
    }
    
    // Transactions
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow write: if false; // Only server-side
    }
    
    // Threads (conversations)
    match /threads/{threadId} {
      // TEMPORARY: Allow full read access for debugging
      // TODO: Restore security after fixing the issue
      allow read, list: if isAuthenticated();
      
      // Users can create threads where they are a participant
      allow create: if isAuthenticated() && 
                       request.auth.uid in request.resource.data.participants;
      
      // Users can update threads where they are participants
      allow update: if isAuthenticated() && 
                       request.auth.uid in resource.data.participants;
      
      // Users can delete threads where they are participants
      allow delete: if isAuthenticated() && 
                       request.auth.uid in resource.data.participants;
    }
    
    // Messages
    match /messages/{messageId} {
      // Users can list and read messages (query will be filtered by threadId)
      allow read, list: if isAuthenticated();
      
      // Users can create messages
      allow create: if isAuthenticated() && 
                       request.resource.data.senderId == request.auth.uid;
      
      // Users can update their own messages
      allow update: if isAuthenticated() && 
                       resource.data.senderId == request.auth.uid;
      
      // Users can delete their own messages
      allow delete: if isAuthenticated() && 
                       resource.data.senderId == request.auth.uid;
    }
    
    // Availabilities collection
    match /availabilities/{availabilityId} {
      // Read: authenticated users can see all availabilities
      allow read: if isAuthenticated();
      
      // Create: only the provider can create their own availabilities
      allow create: if isAuthenticated() && 
                       request.resource.data.providerId == request.auth.uid;
      
      // Update: only the provider can update their own availabilities
      allow update: if isAuthenticated() && 
                       resource.data.providerId == request.auth.uid;
      
      // Delete: only the provider can delete their own availabilities
      allow delete: if isAuthenticated() && 
                       resource.data.providerId == request.auth.uid;
    }
    
    // Availability Settings collection
    match /availability_settings/{providerId} {
      // Read: authenticated users can see settings
      allow read: if isAuthenticated();
      
      // Create/Update: only the provider can manage their settings
      allow create, update: if isAuthenticated() && 
                               isOwner(providerId);
      
      // Delete: not allowed
      allow delete: if false;
    }
    
    // ============================================================================
    // REVIEWS & REVIEW STATS COLLECTIONS
    // ============================================================================
    
    // Helper function: Check if booking is completed
    function isBookingCompleted(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data.status == 'completed';
    }
    
    // Helper function: Check if user is participant in booking
    function isBookingParticipant(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId)).data;
      return booking.clientId == request.auth.uid || booking.providerId == request.auth.uid;
    }
    
    // Helper function: Check if review already exists for this booking+reviewer
    function hasExistingReview(bookingId, reviewerId) {
      return exists(/databases/$(database)/documents/reviews/$(bookingId + '_' + reviewerId));
    }
    
    // Helper function: Check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      // READ: Public (anyone authenticated can see reviews)
      allow read: if isAuthenticated();
      
      // CREATE: Must be authenticated + booking participant + booking completed + no duplicate
      allow create: if isAuthenticated() && 
                       request.resource.data.reviewerId == request.auth.uid &&
                       isBookingParticipant(request.resource.data.bookingId) &&
                       isBookingCompleted(request.resource.data.bookingId) &&
                       !hasExistingReview(request.resource.data.bookingId, request.auth.uid) &&
                       // Validate required fields
                       request.resource.data.keys().hasAll(['bookingId', 'taskId', 'reviewerId', 'reviewedUserId', 'reviewType', 'rating', 'createdAt']) &&
                       // Rating must be 1-5
                       request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
                       // Comment must be at least 20 chars if present
                       (!request.resource.data.keys().hasAny(['comment']) || request.resource.data.comment.size() >= 20) &&
                       // Max 5 photos
                       (!request.resource.data.keys().hasAny(['photos']) || request.resource.data.photos.size() <= 5);
      
      // UPDATE: Only for specific cases
      allow update: if isAuthenticated() && (
        // Case 1: Provider adding response to review
        (resource.data.reviewedUserId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response', 'updatedAt']) &&
         request.resource.data.response.keys().hasAll(['text', 'respondedAt'])) ||
        
        // Case 2: Marking review as helpful (helpfulCount, helpfulVoters)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount', 'helpfulVoters', 'updatedAt'])) ||
        
        // Case 3: Admin moderation (reported, moderationStatus)
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasAny(['reported', 'moderationStatus', 'moderationNotes', 'updatedAt']))
      );
      
      // DELETE: Admin only
      allow delete: if isAdmin();
    }
    
    // Review Stats collection (aggregated stats per user)
    match /review_stats/{userId} {
      // READ: Public (anyone authenticated can see stats)
      allow read: if isAuthenticated();
      
      // WRITE: Only Cloud Functions (no direct client writes)
      allow create, update, delete: if false;
    }
  }
}
