rules_version = '2';

/**
 * Règles de sécurité Firestore pour les collections de paiements
 * Phase 1 : Paiements & Finances
 * 
 * Ces règles doivent être fusionnées avec firestore.rules principal
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    // Vérifie si l'utilisateur est admin
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['admin']);
    }
    
    // Vérifie si l'utilisateur est le propriétaire
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Vérifie si l'utilisateur est professionnel
    function isProfessional() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['professional', 'provider']);
    }
    
    // Vérifie si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }
    
    
    // ==================== TRANSACTIONS ====================
    
    /**
     * Collection: transactions
     * Description: Toutes les transactions financières de la plateforme
     * 
     * Règles:
     * - Lecture: Propriétaire ou Admin
     * - Création: Système uniquement (Cloud Functions)
     * - Modification: Admin uniquement (pour corrections/remboursements)
     * - Suppression: Interdit
     */
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) || 
        isAdmin()
      );
      
      // Création: uniquement via Cloud Functions (service account)
      allow create: if false;
      
      // Modification: admin uniquement (statut, remboursement)
      allow update: if isAdmin() && (
        // Seuls certains champs modifiables
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 
          'refundAmount', 
          'refundedAt', 
          'errorMessage', 
          'errorCode',
          'notes',
          'updatedAt'
        ])
      );
      
      // Suppression interdite
      allow delete: if false;
    }
    
    
    // ==================== PAYOUTS ====================
    
    /**
     * Collection: payouts
     * Description: Virements vers les professionnels
     * 
     * Règles:
     * - Lecture: Professionnel concerné ou Admin
     * - Création: Professionnel (demande de virement)
     * - Modification: Admin (validation/rejet)
     * - Suppression: Admin (si status = pending)
     */
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.professionalId) || 
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      
      // Création: professionnel peut demander un virement
      allow create: if isAuthenticated() && 
                       isProfessional() &&
                       request.resource.data.professionalId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.netAmount > 0;
      
      // Modification: admin pour approve/reject
      allow update: if isAdmin() && (
        // Changement de statut
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'approvedBy',
          'approvedAt',
          'rejectedBy',
          'rejectedAt',
          'rejectionReason',
          'stripePayoutId',
          'processedAt',
          'paidAt',
          'failedAt',
          'errorMessage',
          'notes',
          'updatedAt'
        ])
      );
      
      // Suppression: admin si pending
      allow delete: if isAdmin() && resource.data.status == 'pending';
    }
    
    
    // ==================== WALLETS ====================
    
    /**
     * Collection: wallets
     * Description: Portefeuilles utilisateurs
     * 
     * Règles:
     * - Lecture: Propriétaire ou Admin
     * - Création: Système lors de création utilisateur
     * - Modification: Système uniquement (via Cloud Functions)
     * - Suppression: Interdit
     */
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (
        isOwner(walletId) || // walletId = userId
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      
      // Création/modification: système uniquement
      allow create, update: if false;
      
      // Suppression interdite
      allow delete: if false;
    }
    
    
    // ==================== BANK ACCOUNTS ====================
    
    /**
     * Collection: bankAccounts
     * Description: Comptes bancaires des utilisateurs (IBAN)
     * 
     * Règles:
     * - Lecture: Propriétaire ou Admin
     * - Création: Utilisateur (son propre compte)
     * - Modification: Propriétaire (certains champs) ou Admin
     * - Suppression: Propriétaire ou Admin
     */
    match /bankAccounts/{accountId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      
      // Création: utilisateur peut ajouter son IBAN
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.isVerified == false;
      
      // Modification: 
      // - Propriétaire: isDefault, isDisabled
      // - Admin: tous les champs (vérification, statut)
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.userId) && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDefault', 'updatedAt'])) ||
        isAdmin()
      );
      
      // Suppression: propriétaire ou admin
      allow delete: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
    }
    
    
    // ==================== WITHDRAWALS ====================
    
    /**
     * Collection: withdrawals
     * Description: Retraits vers carte/banque
     * 
     * Règles:
     * - Lecture: Propriétaire ou Admin
     * - Création: Utilisateur (demande de retrait)
     * - Modification: Système/Admin (traitement)
     * - Suppression: Interdit
     */
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      
      // Création: utilisateur peut demander un retrait
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.amount > 0;
      
      // Modification: admin/système pour traitement
      allow update: if isAdmin();
      
      // Suppression interdite
      allow delete: if false;
    }
    
    
    // ==================== TRANSFERS ====================
    
    /**
     * Collection: transfers
     * Description: Transferts internes entre portefeuilles
     * 
     * Règles:
     * - Lecture: Utilisateurs impliqués ou Admin
     * - Création: Système uniquement (Cloud Functions)
     * - Modification: Système uniquement
     * - Suppression: Interdit
     */
    match /transfers/{transferId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.fromUserId) ||
        isOwner(resource.data.toUserId) ||
        isAdmin()
      );
      
      // Création/modification: système uniquement
      allow create, update: if false;
      
      // Suppression interdite
      allow delete: if false;
    }
    
    
    // ==================== BANK STATEMENTS ====================
    
    /**
     * Collection: bankStatements
     * Description: Relevés bancaires importés (CSV/PDF)
     * 
     * Règles:
     * - Lecture: Admin uniquement
     * - Création: Admin (upload)
     * - Modification: Admin
     * - Suppression: Admin
     */
    match /bankStatements/{statementId} {
      allow read, write: if isAdmin();
    }
    
    
    // ==================== BANK STATEMENT ENTRIES ====================
    
    /**
     * Collection: bankStatementEntries
     * Description: Lignes individuelles des relevés bancaires
     * 
     * Règles:
     * - Lecture: Admin uniquement
     * - Écriture: Admin uniquement
     */
    match /bankStatementEntries/{entryId} {
      allow read, write: if isAdmin();
    }
    
    
    // ==================== RECONCILIATIONS ====================
    
    /**
     * Collection: reconciliations
     * Description: Rapports de réconciliation bancaire
     * 
     * Règles:
     * - Lecture: Admin uniquement
     * - Création: Admin (génération rapport)
     * - Modification: Admin (validation)
     * - Suppression: Admin
     */
    match /reconciliations/{reconId} {
      allow read, write: if isAdmin();
    }
    
    
    // ==================== COMMISSION RULES ====================
    
    /**
     * Collection: commissionRules
     * Description: Règles de calcul des commissions
     * 
     * Règles:
     * - Lecture: Tous (pour calculs côté client)
     * - Écriture: Admin uniquement
     */
    match /commissionRules/{ruleId} {
      allow read: if true; // Public pour calculs
      allow write: if isAdmin();
    }
    
    
    // ==================== PAYMENT ANALYTICS ====================
    
    /**
     * Collection: paymentAnalytics
     * Description: Métriques agrégées (daily/weekly/monthly)
     * 
     * Règles:
     * - Lecture: Admin uniquement
     * - Écriture: Système uniquement (Cloud Functions)
     */
    match /paymentAnalytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false; // Système uniquement
    }
  }
}
